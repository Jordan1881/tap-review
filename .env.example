# Local dev: SQLite (zero setup) OR Postgres via docker compose
# SQLite (default):
DATABASE_URL="file:./dev.db"

# Postgres (production / optional local via `docker compose up -d`):
# DATABASE_URL="postgresql://tapreview:tapreview@localhost:5432/tapreview"

# Public URL used for short links and QR codes
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-secret-at-least-32-chars"
