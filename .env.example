# Local Postgres via `docker compose up -d`
DATABASE_URL="postgresql://tapreview:tapreview@localhost:5432/tapreview"

# Public URL used for short links and QR codes
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session signing secret — generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-secret-at-least-32-chars"

# Set to "false" to close public signup
SIGNUP_ENABLED="true"
